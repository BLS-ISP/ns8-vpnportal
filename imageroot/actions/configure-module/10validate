#!/usr/bin/env python3
"""Validate WireGuard port, subnet collisions, split-tunnel CIDRs, and NS8 user domain."""

from __future__ import annotations

import json
import os
import sys

_PYPKG = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "pypkg"))
if _PYPKG not in sys.path:
    sys.path.insert(0, _PYPKG)

import agent  # type: ignore[import-not-found]
from agent.ldapproxy import Ldapproxy  # type: ignore[import-not-found]
import vpn_helpers

raw = sys.stdin.read().strip()
data = json.loads(raw) if raw else {}

module_id = vpn_helpers.get_module_id()
user_domain = str(data.get("user_domain") or "").strip()

known_domains = None
if user_domain:
    known_domains = Ldapproxy().get_domains_list()

errors = vpn_helpers.validate_module_config(
    data,
    module_id=module_id,
    known_domains=known_domains,
)

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, sys.stdout)
    sys.exit(2)
