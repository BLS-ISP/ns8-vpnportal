#!/usr/bin/env python3
"""Validate remote branch CIDRs against wg0/host routes and create a Site-to-Site tunnel."""

from __future__ import annotations

import ipaddress
import json
import os
import re
import sys

_PYPKG = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "pypkg"))
if _PYPKG not in sys.path:
    sys.path.insert(0, _PYPKG)

import agent  # type: ignore[import-not-found]
import vpn_helpers

raw = sys.stdin.read().strip()
data = json.loads(raw) if raw else {}

errors = vpn_helpers.validate_s2s_tunnel_input(data)
if errors:
    agent.set_status("validation-failed")
    json.dump(errors, sys.stdout)
    sys.exit(2)

raw_cidrs = data.get("remote_cidrs") or []
cidr_list = (
    [str(ipaddress.ip_network(c.strip(), strict=False)) for c in re.split(r"[,\n]+", raw_cidrs) if c.strip()]
    if isinstance(raw_cidrs, str)
    else [str(ipaddress.ip_network(str(c).strip(), strict=False)) for c in raw_cidrs if str(c).strip()]
)

payload = {
    "name": str(data.get("name") or "").strip(),
    "remote_cidrs": cidr_list,
    "remote_endpoint": str(data.get("remote_endpoint") or "").strip(),
    "remote_public_key": str(data.get("remote_public_key") or "").strip(),
}

try:
    resp = vpn_helpers.admin_api_request("POST", "/api/v1/admin/s2s", payload=payload, timeout=20.0)
except vpn_helpers.AdminApiError as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)

json.dump(resp, sys.stdout)
