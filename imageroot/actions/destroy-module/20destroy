#!/usr/bin/env python3
"""Clean up Traefik routes, domain bindings, firewalld zone/policy, and kernel objects."""

from __future__ import annotations

import os
import sys

_PYPKG = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "pypkg"))
if _PYPKG not in sys.path:
    sys.path.insert(0, _PYPKG)

import agent  # type: ignore[import-not-found]
import vpn_helpers

module_id = vpn_helpers.get_module_id()

# 1. Remove Traefik route if registered
try:
    traefik_id = agent.resolve_agent_id("traefik@node")
    if traefik_id:
        agent.tasks.run(
            agent_id=traefik_id,
            action="delete-route",
            data={"instance": module_id},
        )
except Exception as exc:
    print(f"Warning: could not remove Traefik route: {exc}", file=sys.stderr)

# 2. Unbind user domains
try:
    agent.bind_user_domains([])
except Exception as exc:
    print(f"Warning: could not unbind user domains: {exc}", file=sys.stderr)

# 3. Remove public service port, dedicated firewalld zone/policy, wg link, and nft table
vpn_helpers.cleanup_host_firewall(agent, module_id)
