#!/usr/bin/env python3
"""Retrieve rendered WireGuard .conf text and SVG QR code for an existing peer."""

from __future__ import annotations

import json
import os
import sys
import urllib.parse

_PYPKG = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "pypkg"))
if _PYPKG not in sys.path:
    sys.path.insert(0, _PYPKG)

import vpn_helpers

raw = sys.stdin.read().strip()
data = json.loads(raw) if raw else {}
peer_id = urllib.parse.quote(str(data.get("peer_id") or "").strip(), safe="")

try:
    resp = vpn_helpers.admin_api_request("GET", f"/api/v1/admin/peers/{peer_id}/config", timeout=15.0)
except vpn_helpers.AdminApiError as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)

json.dump(resp, sys.stdout)
