{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "list-audit-logs output",
  "type": "object",
  "required": [
    "entries",
    "total"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "event_type",
          "actor",
          "username",
          "peer_id",
          "details"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "timestamp": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "peer_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    }
  }
}
