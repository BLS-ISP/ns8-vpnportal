#!/usr/bin/env python3
"""Return synced users, registered peers, and live WireGuard traffic/handshake telemetry."""

from __future__ import annotations

import json
import os
import sys

_PYPKG = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "pypkg"))
if _PYPKG not in sys.path:
    sys.path.insert(0, _PYPKG)

import vpn_helpers

module_id = vpn_helpers.get_module_id()
state_dir = vpn_helpers.get_state_dir(module_id)
sock_path = vpn_helpers.get_admin_socket_path(module_id, state_dir=state_dir)
configured = os.environ.get("CONFIGURED", "false").strip().lower() == "true"

if not sock_path.exists() and not configured:
    max_dev = int(os.environ.get("MAX_DEVICES_PER_USER") or vpn_helpers.DEFAULT_MAX_DEVICES_PER_USER)
    json.dump(
        {
            "users": [],
            "peers": [],
            "summary": {
                "authorized_users": 0,
                "total_peers": 0,
                "active_peers": 0,
                "online_peers": 0,
                "max_devices_per_user": max_dev,
            },
        },
        sys.stdout,
    )
    sys.exit(0)

try:
    resp = vpn_helpers.admin_api_request("GET", "/api/v1/admin/peers", socket_path=sock_path, timeout=15.0)
except vpn_helpers.AdminApiError as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)

json.dump(resp, sys.stdout)
