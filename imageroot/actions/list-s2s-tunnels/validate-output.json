{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "list-s2s-tunnels output",
  "type": "object",
  "required": [
    "tunnels"
  ],
  "properties": {
    "tunnels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "enabled",
          "assigned_ip",
          "public_key",
          "remote_cidrs",
          "online",
          "rx_bytes",
          "tx_bytes",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "assigned_ip": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "remote_endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote_cidrs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "online": {
            "type": "boolean"
          },
          "rx_bytes": {
            "type": "integer"
          },
          "tx_bytes": {
            "type": "integer"
          },
          "last_handshake_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
