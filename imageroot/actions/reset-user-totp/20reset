#!/usr/bin/env python3
"""Reset an employee's TOTP 2FA enrollment for helpdesk recovery."""

from __future__ import annotations

import json
import os
import sys
import urllib.parse

_PYPKG = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "pypkg"))
if _PYPKG not in sys.path:
    sys.path.insert(0, _PYPKG)

import vpn_helpers

raw = sys.stdin.read().strip()
data = json.loads(raw) if raw else {}
username = str(data.get("username") or "").strip()
encoded_user = urllib.parse.quote(username, safe="")

try:
    resp = vpn_helpers.admin_api_request(
        "POST",
        f"/api/v1/admin/users/{encoded_user}/reset-totp",
        payload={},
        timeout=15.0,
    )
except vpn_helpers.AdminApiError as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)

json.dump(resp, sys.stdout)
